new file mode 100644
index 0000000..42536ff
--- /dev/null
+++ b/client/control_shutdown_test.go
@@ -0,0 +1,94 @@
+package client
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/fatedier/frp/pkg/msg"
+	"github.com/fatedier/frp/pkg/util/xlog"
+)
+
+type blockingMessageConnector struct {
+	started chan struct{}
+	release chan struct{}
+	once    sync.Once
+}
+
+func (c *blockingMessageConnector) Connect() (*msg.Conn, error) {
+	c.once.Do(func() { close(c.started) })
+	<-c.release
+	return nil, errors.New("connector closed")
+}
+
+func (c *blockingMessageConnector) Close() error {
+	return nil
+}
+
+func TestControlWaitsForStartedReqWorkConnHandler(t *testing.T) {
+	connector := &blockingMessageConnector{
+		started: make(chan struct{}),
+		release: make(chan struct{}),
+	}
+	ctl := &Control{
+		xl: xlog.FromContextSafe(context.Background()),
+		sessionCtx: &SessionContext{
+			Connector: connector,
+		},
+	}
+
+	ctl.handleReqWorkConnAsync(&msg.ReqWorkConn{})
+	select {
+	case <-connector.started:
+	case <-time.After(time.Second):
+		t.Fatal("async ReqWorkConn handler did not start")
+	}
+
+	waitDone := make(chan struct{})
+	go func() {
+		ctl.waitAsyncHandlers()
+		close(waitDone)
+	}()
+	select {
+	case <-waitDone:
+		t.Fatal("waitAsyncHandlers returned before the started handler exited")
+	case <-time.After(50 * time.Millisecond):
+	}
+
+	close(connector.release)
+	select {
+	case <-waitDone:
+	case <-time.After(time.Second):
+		t.Fatal("waitAsyncHandlers did not return after the handler exited")
+	}
+}
+
+func TestServiceStopWaitsForControllerWorker(t *testing.T) {
+	svr := &Service{}
+	release := make(chan struct{})
+	svr.controllerWG.Add(1)
+	go func() {
+		defer svr.controllerWG.Done()
+		<-release
+	}()
+
+	stopDone := make(chan struct{})
+	go func() {
+		svr.stop()
+		close(stopDone)
+	}()
+	select {
+	case <-stopDone:
+		t.Fatal("stop returned before the controller worker exited")
+	case <-time.After(50 * time.Millisecond):
+	}
+
+	close(release)
+	select {
+	case <-stopDone:
+	case <-time.After(time.Second):
+		t.Fatal("stop did not return after the controller worker exited")
+	}
+}
