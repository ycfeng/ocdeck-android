index 0000000..c329442
--- /dev/null
+++ b/pkg/msg/handler_test.go
@@ -0,0 +1,68 @@
+package msg
+
+import (
+	"io"
+	"sync"
+	"testing"
+	"time"
+)
+
+type blockingDispatcherReadWriter struct {
+	readRelease  chan struct{}
+	writeStarted chan struct{}
+	writeRelease chan struct{}
+	writeOnce    sync.Once
+}
+
+func (rw *blockingDispatcherReadWriter) ReadMsg() (Message, error) {
+	<-rw.readRelease
+	return nil, io.EOF
+}
+
+func (rw *blockingDispatcherReadWriter) ReadMsgInto(Message) error {
+	return nil
+}
+
+func (rw *blockingDispatcherReadWriter) WriteMsg(Message) error {
+	rw.writeOnce.Do(func() { close(rw.writeStarted) })
+	<-rw.writeRelease
+	return nil
+}
+
+func TestDispatcherWaitJoinsReadAndSendLoops(t *testing.T) {
+	rw := &blockingDispatcherReadWriter{
+		readRelease:  make(chan struct{}),
+		writeStarted: make(chan struct{}),
+		writeRelease: make(chan struct{}),
+	}
+	dispatcher := NewDispatcher(rw)
+	dispatcher.Run()
+
+	if err := dispatcher.Send(&Ping{}); err != nil {
+		t.Fatalf("send message: %v", err)
+	}
+	select {
+	case <-rw.writeStarted:
+	case <-time.After(time.Second):
+		t.Fatal("send loop did not start the blocking write")
+	}
+
+	close(rw.readRelease)
+	waitDone := make(chan struct{})
+	go func() {
+		dispatcher.Wait()
+		close(waitDone)
+	}()
+	select {
+	case <-waitDone:
+		t.Fatal("Wait returned before the blocked send loop exited")
+	case <-time.After(50 * time.Millisecond):
+	}
+
+	close(rw.writeRelease)
+	select {
+	case <-waitDone:
+	case <-time.After(time.Second):
+		t.Fatal("Wait did not return after both dispatcher loops exited")
+	}
+}
