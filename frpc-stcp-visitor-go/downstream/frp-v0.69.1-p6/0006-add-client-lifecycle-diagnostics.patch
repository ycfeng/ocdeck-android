--- /dev/null
+++ b/pkg/msg/lifecycle_diagnostics.go
@@ -0,0 +1,41 @@
+package msg
+
+import "sync/atomic"
+
+var (
+	diagnosticDispatcherSendLoops          atomic.Int64
+	diagnosticDispatcherReadLoops          atomic.Int64
+	diagnosticDispatcherSendLoopsStarted   atomic.Int64
+	diagnosticDispatcherSendLoopsCompleted atomic.Int64
+	diagnosticDispatcherReadLoopsStarted   atomic.Int64
+	diagnosticDispatcherReadLoopsCompleted atomic.Int64
+)
+
+func trackDispatcherSendLoop() func() {
+	diagnosticDispatcherSendLoops.Add(1)
+	diagnosticDispatcherSendLoopsStarted.Add(1)
+	return func() {
+		diagnosticDispatcherSendLoops.Add(-1)
+		diagnosticDispatcherSendLoopsCompleted.Add(1)
+	}
+}
+
+func trackDispatcherReadLoop() func() {
+	diagnosticDispatcherReadLoops.Add(1)
+	diagnosticDispatcherReadLoopsStarted.Add(1)
+	return func() {
+		diagnosticDispatcherReadLoops.Add(-1)
+		diagnosticDispatcherReadLoopsCompleted.Add(1)
+	}
+}
+
+// AppendLifecycleDiagnostics adds aggregate dispatcher owner counts without
+// exposing message payloads, connection identities, or goroutine identities.
+func AppendLifecycleDiagnostics(out map[string]int64, prefix string) {
+	out[prefix+"dispatcherSendLoops"] = diagnosticDispatcherSendLoops.Load()
+	out[prefix+"dispatcherReadLoops"] = diagnosticDispatcherReadLoops.Load()
+	out[prefix+"dispatcherSendLoopsStartedTotal"] = diagnosticDispatcherSendLoopsStarted.Load()
+	out[prefix+"dispatcherSendLoopsCompletedTotal"] = diagnosticDispatcherSendLoopsCompleted.Load()
+	out[prefix+"dispatcherReadLoopsStartedTotal"] = diagnosticDispatcherReadLoopsStarted.Load()
+	out[prefix+"dispatcherReadLoopsCompletedTotal"] = diagnosticDispatcherReadLoopsCompleted.Load()
+}
