+// RuntimeLifecycleDiagnosticsSnapshot returns aggregate lifecycle counts only.
+// It does not expose goroutine names, stacks, endpoints, paths, visitor names,
+// server names, connection identities, or credentials.
+func RuntimeLifecycleDiagnosticsSnapshot() map[string]int64 {
+	out := map[string]int64{
+		"client.serviceControllerWorkers":               diagnosticServiceControllerWorkers.Load(),
