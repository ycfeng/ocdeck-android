+		"client.controlDispatcherOwnersStartedTotal":    diagnosticControlDispatcherOwnersStarted.Load(),
+		"client.controlDispatcherOwnersCompletedTotal":  diagnosticControlDispatcherOwnersCompleted.Load(),
+		"client.reqWorkConnHandlers":                    diagnosticReqWorkConnHandlers.Load(),
+		"client.reqWorkConnHandlersStartedTotal":        diagnosticReqWorkConnHandlersStarted.Load(),
+		"client.reqWorkConnHandlersCompletedTotal":      diagnosticReqWorkConnHandlersCompleted.Load(),
+		"client.pendingWorkConns":                       diagnosticPendingWorkConns.Load(),
+		"client.pendingWorkConnsStartedTotal":           diagnosticPendingWorkConnsStarted.Load(),
+		"client.pendingWorkConnsCompletedTotal":         diagnosticPendingWorkConnsCompleted.Load(),
+		"client.connectors":                             diagnosticConnectors.Load(),
+		"client.connectorsStartedTotal":                 diagnosticConnectorsStarted.Load(),
+		"client.connectorsCompletedTotal":               diagnosticConnectorsCompleted.Load(),
+		"client.tcpMuxSessions":                         diagnosticTcpMuxSessions.Load(),
+		"client.tcpMuxSessionsStartedTotal":             diagnosticTcpMuxSessionsStarted.Load(),
+		"client.tcpMuxSessionsCompletedTotal":           diagnosticTcpMuxSessionsCompleted.Load(),
+		"client.tcpMuxStreams":                          diagnosticTcpMuxStreams.Load(),
+		"client.tcpMuxStreamsStartedTotal":              diagnosticTcpMuxStreamsStarted.Load(),
+		"client.tcpMuxStreamsCompletedTotal":            diagnosticTcpMuxStreamsCompleted.Load(),
+		"client.connectorCloseTotal":                    diagnosticConnectorCloseTotal.Load(),
+	}
+	msg.AppendLifecycleDiagnostics(out, "msg.")
+	visitor.AppendLifecycleDiagnostics(out, "visitor.")
+	return out
+}
