+	diagnosticAcceptLoopsStarted        atomic.Int64
+	diagnosticAcceptLoopsCompleted      atomic.Int64
+	diagnosticHandlers                  atomic.Int64
+	diagnosticHandlersStarted           atomic.Int64
+	diagnosticHandlersCompleted         atomic.Int64
