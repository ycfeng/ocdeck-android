+}
+
+// AppendLifecycleDiagnostics adds aggregate visitor owner counts without
+// exposing visitor names, server names, endpoints, or connection identities.
+func AppendLifecycleDiagnostics(out map[string]int64, prefix string) {
+	out[prefix+"managers"] = diagnosticManagers.Load()
+	out[prefix+"managersStartedTotal"] = diagnosticManagersStarted.Load()
+	out[prefix+"managersCompletedTotal"] = diagnosticManagersCompleted.Load()
+	out[prefix+"keepers"] = diagnosticKeepers.Load()
+	out[prefix+"keepersStartedTotal"] = diagnosticKeepersStarted.Load()
+	out[prefix+"keepersCompletedTotal"] = diagnosticKeepersCompleted.Load()
+	out[prefix+"instances"] = diagnosticVisitorInstances.Load()
+	out[prefix+"instancesStartedTotal"] = diagnosticVisitorInstancesStarted.Load()
+	out[prefix+"instancesCompletedTotal"] = diagnosticVisitorInstancesCompleted.Load()
+	out[prefix+"acceptLoops"] = diagnosticAcceptLoops.Load()
+	out[prefix+"acceptLoopsStartedTotal"] = diagnosticAcceptLoopsStarted.Load()
+	out[prefix+"acceptLoopsCompletedTotal"] = diagnosticAcceptLoopsCompleted.Load()
+	out[prefix+"handlers"] = diagnosticHandlers.Load()
+	out[prefix+"handlersStartedTotal"] = diagnosticHandlersStarted.Load()
+	out[prefix+"handlersCompletedTotal"] = diagnosticHandlersCompleted.Load()
+	out[prefix+"userConns"] = diagnosticUserConns.Load()
+	out[prefix+"userConnsStartedTotal"] = diagnosticUserConnsStarted.Load()
+	out[prefix+"userConnsCompletedTotal"] = diagnosticUserConnsCompleted.Load()
+	out[prefix+"outboundDials"] = diagnosticOutboundDials.Load()
+	out[prefix+"outboundDialsStartedTotal"] = diagnosticOutboundDialsStarted.Load()
+	out[prefix+"outboundDialsCompletedTotal"] = diagnosticOutboundDialsCompleted.Load()
+	out[prefix+"outboundConns"] = diagnosticOutboundConns.Load()
+	out[prefix+"outboundConnsStartedTotal"] = diagnosticOutboundConnsStarted.Load()
+	out[prefix+"outboundConnsCompletedTotal"] = diagnosticOutboundConnsCompleted.Load()
+}
