+	diagnosticReqWorkConnHandlers               atomic.Int64
+	diagnosticReqWorkConnHandlersStarted        atomic.Int64
+	diagnosticReqWorkConnHandlersCompleted      atomic.Int64
+	diagnosticPendingWorkConns                  atomic.Int64
+	diagnosticPendingWorkConnsStarted           atomic.Int64
+	diagnosticPendingWorkConnsCompleted         atomic.Int64
+	diagnosticConnectors                        atomic.Int64
+	diagnosticConnectorsStarted                 atomic.Int64
+	diagnosticConnectorsCompleted               atomic.Int64
