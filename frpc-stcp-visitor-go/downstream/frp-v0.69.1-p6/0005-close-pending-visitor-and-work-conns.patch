new file mode 100644
index 0000000..62b588a
--- /dev/null
+++ b/client/control_pending_work_conn_test.go
@@ -0,0 +1,45 @@
+package client
+
+import (
+	"net"
+	"testing"
+	"time"
+
+	"github.com/fatedier/frp/pkg/msg"
+)
+
+func TestControlWaitClosesPendingWorkConn(t *testing.T) {
+	clientConn, serverConn := net.Pipe()
+	defer clientConn.Close()
+	workConn := msg.NewConn(serverConn, msg.NewReadWriter(serverConn, ""))
+
+	ctl := &Control{}
+	if !ctl.trackPendingWorkConn(workConn) {
+		t.Fatal("trackPendingWorkConn rejected an open control")
+	}
+	ctl.handlerWG.Add(1)
+	handlerDone := make(chan struct{})
+	go func() {
+		defer ctl.handlerWG.Done()
+		defer close(handlerDone)
+		var start msg.StartWorkConn
+		_ = workConn.ReadMsgInto(&start)
+	}()
+
+	waitDone := make(chan struct{})
+	go func() {
+		ctl.waitAsyncHandlers()
+		close(waitDone)
+	}()
+	select {
+	case <-waitDone:
+	case <-time.After(time.Second):
+		t.Fatal("waitAsyncHandlers did not close the pending work connection")
+	}
+	select {
+	case <-handlerDone:
+	default:
+		t.Fatal("waitAsyncHandlers returned before the pending handler exited")
+	}
+}
