new file mode 100644
index 0000000..224b30b
--- /dev/null
+++ b/client/visitor/visitor_outbound_shutdown_test.go
@@ -0,0 +1,47 @@
+package visitor
+
+import (
+	"net"
+	"testing"
+	"time"
+
+	netpkg "github.com/fatedier/frp/pkg/util/net"
+)
+
+func TestBaseVisitorCloseClosesTrackedOutboundConn(t *testing.T) {
+	base := &BaseVisitor{
+		ctx:           t.Context(),
+		internalLn:    netpkg.NewInternalListener(),
+		activeConns:   make(map[net.Conn]struct{}),
+		outboundConns: make(map[net.Conn]struct{}),
+	}
+	clientConn, outboundConn := net.Pipe()
+	defer clientConn.Close()
+	untrack, ok := base.trackOutboundConn(outboundConn)
+	if !ok {
+		t.Fatal("trackOutboundConn rejected an open visitor")
+	}
+	defer untrack()
+
+	base.handlerWG.Add(1)
+	handlerDone := make(chan struct{})
+	go func() {
+		defer base.handlerWG.Done()
+		defer close(handlerDone)
+		var buffer [1]byte
+		_, _ = outboundConn.Read(buffer[:])
+	}()
+
+	closeDone := make(chan struct{})
+	go func() {
+		base.Close()
+		close(closeDone)
+	}()
+	select {
+	case <-closeDone:
+	case <-time.After(time.Second):
+		t.Fatal("Close did not close and wait for the outbound connection")
+	}
+	select {
+	case <-handlerDone:
+	default:
+		t.Fatal("Close returned before the outbound handler exited")
+	}
+}
