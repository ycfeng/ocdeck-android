diff --git a/client/connector_tls_config_customizer_test.go b/client/connector_tls_config_customizer_test.go
new file mode 100644
--- /dev/null
+++ b/client/connector_tls_config_customizer_test.go
@@ -0,0 +1,44 @@
+package client
+
+import (
+	"context"
+	"crypto/tls"
+	"errors"
+	"testing"
+
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+)
+
+func TestConnectorTLSConfigCustomizer(t *testing.T) {
+	expected := errors.New("synthetic tls customizer failure")
+	called := false
+	connector := NewConnectorWithTLSConfigCustomizer(
+		context.Background(),
+		&v1.ClientCommonConfig{},
+		func(config *tls.Config) error {
+			called = true
+			if config == nil {
+				t.Fatal("customizer received a nil TLS config")
+			}
+			return expected
+		},
+	).(*defaultConnectorImpl)
+
+	if err := connector.customizeTLSConfig(&tls.Config{}); !errors.Is(err, expected) {
+		t.Fatalf("unexpected customizer error: %v", err)
+	}
+	if !called {
+		t.Fatal("TLS config customizer was not called")
+	}
+}
+
+func TestConnectorWithoutTLSConfigCustomizer(t *testing.T) {
+	connector := NewConnector(context.Background(), &v1.ClientCommonConfig{}).(*defaultConnectorImpl)
+	if err := connector.customizeTLSConfig(&tls.Config{}); err != nil {
+		t.Fatalf("unexpected customizer error: %v", err)
+	}
+}
