diff --git a/client/visitor/visitor_shutdown_test.go b/client/visitor/visitor_shutdown_test.go
new file mode 100644
--- /dev/null
+++ b/client/visitor/visitor_shutdown_test.go
@@ -0,0 +1,55 @@
+package visitor
+
+import (
+	"net"
+	"testing"
+	"time"
+
+	netpkg "github.com/fatedier/frp/pkg/util/net"
+)
+
+func TestBaseVisitorCloseWaitsForActiveHandler(t *testing.T) {
+	base := &BaseVisitor{
+		ctx:         t.Context(),
+		internalLn:  netpkg.NewInternalListener(),
+		activeConns: make(map[net.Conn]struct{}),
+	}
+	handlerStarted := make(chan struct{})
+	handlerDone := make(chan struct{})
+	base.startAcceptLoop(base.internalLn, "test internal", func(conn net.Conn) {
+		close(handlerStarted)
+		defer close(handlerDone)
+		var buffer [1]byte
+		_, _ = conn.Read(buffer[:])
+	})
+
+	clientConn, visitorConn := net.Pipe()
+	defer clientConn.Close()
+	if err := base.AcceptConn(visitorConn); err != nil {
+		t.Fatalf("accept connection: %v", err)
+	}
+	select {
+	case <-handlerStarted:
+	case <-time.After(time.Second):
+		t.Fatal("handler did not start")
+	}
+
+	closeDone := make(chan struct{})
+	go func() {
+		base.Close()
+		close(closeDone)
+	}()
+	select {
+	case <-closeDone:
+	case <-time.After(time.Second):
+		t.Fatal("Close did not wait for the active handler")
+	}
+	select {
+	case <-handlerDone:
+	default:
+		t.Fatal("Close returned before the active handler exited")
+	}
+}
